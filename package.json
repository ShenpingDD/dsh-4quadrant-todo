{
  "name": "dsh-4quadrant-todo",
  "version": "2.2.1",
  "description": "Four-quadrant todos for DeepSeek Harness, two-way synced with Feishu (Lark) Tasks",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "locale",
    "assets",
    "icon.svg",
    "cordis.patch.yml",
    "scripts",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "todo",
    "eisenhower",
    "four-quadrant",
    "feishu",
    "lark"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShenpingDD/dsh-4quadrant-todo.git"
  },
  "homepage": "https://github.com/ShenpingDD/dsh-4quadrant-todo#readme",
  "bugs": {
    "url": "https://github.com/ShenpingDD/dsh-4quadrant-todo/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  }
}
